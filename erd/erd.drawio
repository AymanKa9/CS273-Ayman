        <mxCell id="c134" value="1:N · groups" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;fontStyle=1;startArrow=ERzeroToOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=14;endSize=14;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c63" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c135" value="1:N · is played in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;fontStyle=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=14;endSize=14;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c98" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c136" value="1:N · defines" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;fontStyle=1;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=14;endSize=14;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c98" target="c108"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c137" value="&lt;b&gt;M:N resolved&lt;/b&gt;&lt;br&gt;Players ⟷ Matches is many-to-many (a player plays many matches; a match has two players). It is resolved by the linking table &lt;b&gt;MatchResults&lt;/b&gt;, one row per player per match, with the composite PK (MatchID, PlayerID)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="c138" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Line labels: relationship type · verb (read parent → child)&lt;br&gt;PK primary key (bold, underlined) · FK foreign key&lt;br&gt;AK alternate key · UQ composite unique&lt;br&gt;┼┼ exactly one (mandatory)&lt;br&gt;○┼ zero or one (optional)&lt;br&gt;○&lt; zero or many (optional)&lt;br&gt;┼&lt; one or many (mandatory)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="940" width="360" height="160" as="geometry"/></mxCell>
        <mxCell id="c139" value="&lt;b&gt;HandicapChart&lt;/b&gt; is a lookup table. A match's races are found by computing the rating gap between the two players and selecting the row where the gap is between MinGap and MaxGap for that format. It joins on a range, not a FK, so it links only to Formats." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="940" width="360" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
