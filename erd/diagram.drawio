        <mxCell id="c74" value="AK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="c73"><mxGeometry width="60" height="30" as="geometry"><mxRectangle width="60" height="30" as="alternateBounds"/></mxGeometry></mxCell>
        <mxCell id="c75" value="format_name : VARCHAR(50) NOT NULL UNIQUE" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;fontStyle=0;" vertex="1" parent="c73"><mxGeometry x="60" width="270" height="30" as="geometry"><mxRectangle width="270" height="30" as="alternateBounds"/></mxGeometry></mxCell>
        <mxCell id="c76" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;html=1;" vertex="1" parent="c69"><mxGeometry y="90" width="330" height="30" as="geometry"/></mxCell>
        <mxCell id="c77" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="c76"><mxGeometry width="60" height="30" as="geometry"><mxRectangle width="60" height="30" as="alternateBounds"/></mxGeometry></mxCell>
        <mxCell id="c78" value="rules_summary : TEXT NULL" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;fontStyle=0;" vertex="1" parent="c76"><mxGeometry x="60" width="270" height="30" as="geometry"><mxRectangle width="270" height="30" as="alternateBounds"/></mxGeometry></mxCell>
        <mxCell id="c79" value="1:N  Players → Player_Matches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=14;endSize=14;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c80" value="1:N  Matches → Player_Matches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;startArrow=ERmandOne;startFill=0;endArrow=ERoneToMany;endFill=0;startSize=14;endSize=14;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c56" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c81" value="1:N  Formats → Matches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=14;endSize=14;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c69" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c82" value="&amp;lt;b&amp;gt;M:N resolved&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Players ⟷ Matches is many-to-many: a player plays many matches and every match has two players. It is resolved by the linking table &amp;lt;b&amp;gt;Player_Matches&amp;lt;/b&amp;gt;, which holds one row per player per match plus that player&#x27;s handicap and score." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="c83" value="&amp;lt;b&amp;gt;Legend&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;PK = primary key (bold, underlined)&amp;lt;br&amp;gt;FK = foreign key&amp;lt;br&amp;gt;AK = alternate key (unique)&amp;lt;br&amp;gt;UQ = composite unique constraint&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;┼┼ exactly one (mandatory)&amp;lt;br&amp;gt;○&amp;lt; zero or many (optional)&amp;lt;br&amp;gt;┼&amp;lt; one or many (mandatory)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="320" width="300" height="175" as="geometry"/></mxCell>
        <mxCell id="c84" value="&amp;lt;b&amp;gt;Participation&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• Every Player_Matches row MUST have one player and one match (FKs NOT NULL).&amp;lt;br&amp;gt;• A player MAY have zero matches (new signup).&amp;lt;br&amp;gt;• A match MUST have at least one Player_Matches row (two in practice).&amp;lt;br&amp;gt;• Every match MUST have one format; a format MAY be unused." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="520" width="300" height="165" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
